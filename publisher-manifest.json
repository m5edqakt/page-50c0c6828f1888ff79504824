p:12px;font-size:12.5px;color:var(--slate-500);line-height:1.7}\n\n  /* ---------- clients ---------- */\n  .client-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n  .client{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);padding:24px}\n  .client h3{font-size:17px;margin-bottom:8px}\n  .client p{font-size:14px;color:var(--slate-700)}\n  .client .meta{margin-top:14px;font-size:12.5px;color:var(--slate-500);letter-spacing:.04em}\n\n  /* ---------- faq ---------- */\n  .faq-list{counter-reset:faq;display:grid;grid-template-columns:1fr 1fr;gap:20px 30px}\n  .faq{counter-increment:faq;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);padding:22px 24px 22px 60px;position:relative}\n  .faq::before{content:counter(faq,decimal-leading-zero);position:absolute;left:22px;top:22px;font-size:13px;font-weight:800;letter-spacing:.06em;color:var(--cyan-dark)}\n  .faq h3{font-size:15.5px;margin-bottom:8px;color:var(--slate-900)}\n  .faq p{font-size:14px;color:var(--slate-700)}\n\n  /* ---------- footer ---------- */\n  footer{background:var(--slate-900);color:#a9bcc5;padding:40px 0 34px;font-size:13.5px}\n  .foot-grid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}\n  .foot-brand{color:#fff;font-weight:700;letter-spacing:.18em;font-size:14px}\n  .foot-note{max-width:44em;margin-top:12px;line-height:1.8;color:#8fa4ae}\n  .foot-links a{color:#cfe3e7;margin-left:18px;white-space:nowrap}\n  .foot-links a:first-child{margin-left:0}\n\n  /* ---------- responsive ---------- */\n  @media (max-width:900px){.hero-grid{grid-template-columns:1fr;}\n    .about-grid{grid-template-columns:1fr;}\n    .steps{grid-template-columns:1fr;}\n    .client-grid{grid-template-columns:1fr;}\n    .faq-list{grid-template-columns:1fr;}\n    .plan{\n      grid-template-columns:1fr;gap:18px;}\n    .plan-price{\n      text-align:left;border-left:0;border-top:1px dashed var(--slate-300);padding-left:0;padding-top:16px;}}\n  @media (max-width:520px){\n    .hero{padding-top:20px;padding-bottom:40px}\n    section{padding:44px 0}\n    .anchors{margin-bottom:26px}\n    .faq{padding:20px 20px 20px 52px}\n    .faq::before{left:18px;top:20px}\n    .foot-links a{margin-left:0;margin-right:16px}\n  }\n</style><header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-top\">\n      <div class=\"brandmark\">火云 <span>/ HUOYUN</span></div>\n      <div class=\"tagline\">网络订阅服务 · 套餐与使用说明</div>\n    </div>\n\n    <nav class=\"anchors\" aria-label=\"首屏页内导航\">\n      <a href=\"#intro\">品牌说明</a>\n      <a href=\"#usage\">怎么用</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n\n    <div class=\"hero-grid\">\n      <div>\n        <div class=\"kicker\">火云 · 本页导读</div>\n        <h1>火云 · 先把规则讲清楚，<br>再谈<em>订阅</em>。</h1>\n        <p class=\"lede\">火云提供按月或按年计费的网络订阅套餐。这一页把套餐内容、使用步骤、客户端情况和常见问题一次列全，方便你在决定之前先把该看的看完。</p>\n        <p class=\"hero-quote\">本页所有数字与权益均以正文所列内容为准。未在本页写明的事项，请以实际服务页面为准，不做额外承诺。</p>\n      </div>\n\n      <aside class=\"hero-panel\">\n        <h2>本页速览</h2>\n        <dl>\n          <div class=\"stat-row\"><dt>套餐档位</dt><dd>三档</dd></div>\n          <div class=\"stat-row\"><dt>计费方式</dt><dd>月付 / 年付</dd></div>\n          <div class=\"stat-row\"><dt>起步价格</dt><dd>¥15 / 月</dd></div>\n          <div class=\"stat-row\"><dt>设备数上限</dt><dd>3 / 5 / 20 台</dd></div>\n          <div class=\"stat-row\"><dt>流量档位</dt><dd>100GB 起</dd></div>\n        </dl>\n        <p class=\"panel-note\">流量、设备数与价格均按下文套餐列表执行。年付价格对应各档位的年度方案。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"intro\" class=\"band\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <span class=\"num\">01 / 品牌说明</span>\n          <h2>火云做什么，不做什么</h2>\n        </div>\n        <p>先把边界说明白，后面读套餐会更快。</p>\n      </div>\n\n      <div class=\"about-grid\">\n        <div class=\"about-text\">\n          <p>火云是一个网络订阅服务品牌。做法很直接：把可用的套餐档位、可连接的设备数量、每月流量额度写在明面上，用户按自己的用量挑一档，按月或按年付费。</p>\n          <p>我们不堆功能名词。三个档位的差别集中在三件事上——每月流量、同时在线设备数、节点资源类型。你只需要判断这三件事哪个对你更要紧。</p>\n          <p>本页不描述具体节点位置、实测速度或线路性能数据，因为这些会随实际情况变化。如果你需要确认某项能力是否覆盖你的使用场景，请通过页面下方的说明渠道核实后再决定。</p>\n        </div>\n\n        <div class=\"note-card\">\n          <h3>阅读本页前，先记住三条</h3>\n          <ul>\n            <li>价格是订阅费用，不是一次性买断。</li>\n            <li>流量按月计算，档位之间不可叠加使用。</li>\n            <li>设备数指同时在线数量，不是累计绑定数量。</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"usage\" class=\"band-alt\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <span class=\"num\">02 / 使用说明</span>\n          <h2>三步走完，从选档到能用</h2>\n        </div>\n        <p>流程不长，按顺序做即可。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"idx\">STEP 01</div>\n          <h3>先算你的用量</h3>\n          <p>回看你上一个月的实际使用情况：每天在线的设备有几台，主要在什么时段用。用量稳定在低位就选基础版，多设备并行就往上走一档，不必一上来就买最高的。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"idx\">STEP 02</div>\n          <h3>选定档位与周期</h3>\n          <p>三档的差别只有流量、设备数和节点资源类型。确定档位后再决定月付还是年付：年付总价更低，但要一次付清，适合已经确认长期会用的人。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"idx\">STEP 03</div>\n          <h3>按说明完成配置</h3>\n          <p>开通后，按你的设备类型选择对应客户端，把订阅信息填入客户端并保存，然后连接测试。若连接不成功，先核对订阅信息是否完整，再检查设备数量是否已超出所选档位上限。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"band\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <span class=\"num\">03 / 套餐</span>\n          <h2>三档套餐，逐行展开</h2>\n        </div>\n        <p>每行一个档位，从低到高排列。价格与权益如下。</p>\n      </div>\n\n      <div class=\"plan-list\">\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">基础版</div>\n            <p class=\"plan-name-sub\">适合单人或少量设备、用量平稳的日常使用。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"plan-price\">\n            <div class=\"price-main\">¥15<small> / 月</small></div>\n            <div class=\"price-alt\">按年付仅需 ¥150 / 年</div>\n            <p class=\"price-note\">年付相当于十个月的价格，需要一次性支付全年费用。</p>\n          </div>\n        </article>\n\n        <article class=\"plan featured\">\n          <div>\n            <div class=\"plan-name\">旗舰版</div>\n            <span class=\"plan-tag\">推荐</span>\n            <p class=\"plan-name-sub\">适合多设备并行、对线路类型有要求的使用者。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-price\">\n            <div class=\"price-main\">¥35<small> / 月</small></div>\n            <div class=\"price-alt\">按年付仅需 ¥350 / 年</div>\n            <p class=\"price-note\">相比基础版，流量与设备数提升，并增加专线类节点资源与优先工单通道。</p>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">团队版</div>\n            <p class=\"plan-name-sub\">适合多人共用、需要统一管理的团队场景。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-price\">\n            <div class=\"price-main\">¥85<small> / 月</small></div>\n            <div class=\"price-alt\">按年付仅需 ¥850 / 年</div>\n            <p class=\"price-note\">定制路由的具体配置方式需与客户经理沟通确认，本页不展开技术细节。</p>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\" class=\"band-alt\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <span class=\"num\">04 / 客户端</span>\n          <h2>用什么软件连</h2>\n        </div>\n        <p>按设备类型选择对应客户端，具体版本与获取方式以实际提供为准。</p>\n      </div>\n\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <h3>桌面端</h3>\n          <p>Windows 与 macOS 各有对应的客户端，安装后在设置中填入订阅信息即可使用。首次使用时建议先确认系统时间准确，避免出现校验问题。</p>\n          <p class=\"meta\">安装包获取方式：以实际提供为准</p>\n        </article>\n        <article class=\"client\">\n          <h3>移动端</h3>\n          <p>Android 与 iOS 设备通过系统应用商店或对应渠道获取客户端。移动网络与 Wi-Fi 之间切换时，部分客户端需要重新连接一次。</p>\n          <p class=\"meta\">可同时在线设备数受所选套餐限制</p>\n        </article>\n        <article class=\"client\">\n          <h3>路由与共享场景</h3>\n          <p>团队版支持企业定制路由，由客户经理协助确认配置方式。是否适合在路由器层面部署，取决于你的网络环境，需先行确认。</p>\n          <p class=\"meta\">仅团队版包含定制路由支持</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"band\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div>\n          <span class=\"num\">05 / 常见问题</span>\n          <h2>买之前常问的几件事</h2>\n        </div>\n        <p>下列回答与本页正文一致，未涉及的内容不作推测。</p>\n      </div>\n\n      <div class=\"faq-list\">\n        <article class=\"faq\">\n          <h3>三档套餐最核心的差别是什么？</h3>\n          <p>每月流量、同时在线设备数、节点资源类型。基础版是 100GB 与 3 台；旗舰版是 300GB 与 5 台，并包含专线类节点与优先工单；团队版是 1000GB 与 20 台，包含 VIP 节点与定制路由支持。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>年付比月付划算多少？</h3>\n          <p>按本页所列价格，三档年付分别是 ¥150、¥350、¥850，对应月付的十个月总额。年付需要一次性付清全年费用。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>“同时在线”是指什么？</h3>\n          <p>指同一时间保持连接的设备数量。基础版 3 台、旗舰版 5 台、团队版 20 台。超出的设备需要先断开其中一台再连接。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>流量用完了会怎样？</h3>\n          <p>本页只说明各档位的月度流量额度，未在本页写明的后续处理方式需按实际服务规则确认。若用量接近上限，可考虑提前调整到更高档位。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>可以先试再买吗？</h3>\n          <p>本页不提供试用相关的说明与承诺。涉及试用、退款或服务期限的具体规则，请通过页面下方说明渠道核实后再决定是否订阅。</p>\n        </article>\n        <article class=\"faq\">\n          <h3>团队版的定制路由需要额外费用吗？</h3>\n          <p>本页未写明定制路由的额外费用。该部分需与客户经理沟通确认，确认结果之后再进入开通流程。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap foot-grid\">\n    <div>\n      <div class=\"foot-brand\">火云</div>\n      <p class=\"foot-note\">本页内容为套餐与使用说明的集中呈现，所列价格、流量与设备数均以正文为准。未在本页写明的事项，请通过正式渠道确认。</p>\n    </div>\n    <div class=\"foot-links\">\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>",
